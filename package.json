{
  "name": "singchorus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:panel": "pnpm --filter @chorus/panel dev",
    "dev:cloud": "pnpm --filter chorus-cloud dev",
    "build": "pnpm -r build",
    "build:panel": "pnpm --filter @chorus/panel build",
    "build:cloud": "pnpm --filter chorus-cloud build",
    "start:panel": "pnpm --filter @chorus/panel start",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "publish:core": "pnpm --filter @chorus/core build && pnpm --filter @chorus/core publish",
    "publish:panel": "pnpm --filter @chorus/panel build && pnpm --filter @chorus/panel publish",
    "publish:ctl": "pnpm --filter @chorus/ctl build && pnpm --filter @chorus/ctl publish"
  },
  "files": [
    "dist-node",
    "migrations",
    "README.md"
  ]
}
