{
  "name": "@chorus/core",
  "version": "0.1.0",
  "description": "SingChorus core engine: config storage, cloud sync and Docker deploy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aixmoyu/SingChorus.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
